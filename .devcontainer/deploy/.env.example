# Staging deployment configuration
STAGING_ALIAS=deploy_da03
STAGING_FQDN=da03.my-host.com # Fully Qualified Domain Name
# STAGING_IP=10.x.y.staging  # Optional: only needed if you want to override DNS resolution
STAGING_USER=deploy
STAGING_PORT=22

# Production deployment configuration
PROD_ALIAS=deploy_da04
PROD_FQDN=da04.my-host.com # Fully Qualified Domain Name
# PROD_IP=10.x.y.prod  # Optional: only needed if you want to override DNS resolution
PROD_USER=deploy
PROD_PORT=22

# Directory with SSH keys on host (absolute path)
# Example: /home/username/.ssh/deploy-keys
DEPLOY_KEYS_DIR=/path/to/your/ssh/key-dir

# Optional VPN DNS servers (use actual DNS servers, not 127.0.0.53)
# These are used when your VPN provides private DNS resolution
# If omitted, the script will use the default DNS configuration
# VPN_DNS1=8.8.8.8
# VPN_DNS2=8.8.4.4