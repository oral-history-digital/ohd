# Copy this file to .env and set real values before running Docker/Podman Compose.
# Do NOT commit .env.
#
# Runtime defaults are loaded from .env.defaults.
# Values in .env override .env.defaults.
# Leave optional values empty when unused.

# Kamal deployment inputs. Set these in .env.kamal.<destination>.
# DEPLOY_STORAGE_DIR is an absolute path on the server.
# DEPLOY_HOST=
# DEPLOY_SSH_USER=
# DEPLOY_SSH_KEY=
# DEPLOY_STORAGE_DIR=
# DEPLOY_DOMAIN=
# DEPLOY_RAILS_ENV=production
# DEPLOY_ARCH=amd64
# DEPLOY_PROXY_HTTP_PORT=8080
# DEPLOY_PROXY_HTTPS_PORT=8443
# OHD_EXTRA_HOSTS=

# -------------------------------------------------------------------
# Required secrets for production/staging
# -------------------------------------------------------------------

# Required in production/staging to use encrypted credentials.yml.enc
RAILS_MASTER_KEY=

# Required for production: Rails secret key base for message verifiers and cookies
# Development and test environments will use a default values set in config/secrets.yml
SECRET_KEY_BASE=

# Kamal's MariaDB accessory. Set this for Kamal deployments.
# MYSQL_PASSWORD below is also passed to the MariaDB application user.
MARIADB_ROOT_PASSWORD=

# -------------------------------------------------------------------
# Runtime mode and app runtime
# Defaults exist in .env.defaults.
# Override only when needed.
# -------------------------------------------------------------------

RAILS_ENV=
RACK_ENV=
NODE_ENV=
PORT=
RAILS_MAX_THREADS=
RAILS_LOG_TO_STDOUT=
RAILS_SERVE_STATIC_FILES=
ALLOW_LOCALHOST_IN_PRODUCTION=

# -------------------------------------------------------------------
# Service endpoints
# Defaults exist in .env.defaults.
# -------------------------------------------------------------------

REDIS_URL=
# SOLR_URL=
# SOLR_LOG_LEVEL=
# SOLR_AUTO_COMMIT_AFTER_REQUEST=
# SOLR_AUTO_COMMIT_AFTER_DELETE_REQUEST=

# -------------------------------------------------------------------
# Domain configuration
# Rails also has defaults in config/initializers/constants.rb.
# -------------------------------------------------------------------

OHD_DOMAIN=
OHD_DOMAIN_DEVELOPMENT=
OHD_DOMAIN_TEST=
OHD_DOMAIN_STAGING=
OHD_DOMAIN_PRODUCTION=

# -------------------------------------------------------------------
# Mail
# Fallback sender for Devise emails without an explicit project sender.
# -------------------------------------------------------------------

DEVISE_MAILER_SENDER=

# -------------------------------------------------------------------
# TLS / certbot
# Used only if the nginx/certbot compose flow is used.
# -------------------------------------------------------------------

LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=

# -------------------------------------------------------------------
# Optional error tracking
# Empty disables Sentry/Bugsink error reporting.
# -------------------------------------------------------------------

SENTRY_DSN=

# -------------------------------------------------------------------
# OpenID Connect
# Use literal '\n' for line breaks when providing a PEM key in one line.
# -------------------------------------------------------------------

OIDC_SIGNING_KEY=
OIDC_ISSUER=

# -------------------------------------------------------------------
# Active Record encryption
# Required to enable OTP multi-factor authentication.
# Generate once with: docker compose exec app bin/rails db:encryption:init
# Keep the generated values stable, secret, backed up, and out of git.
# -------------------------------------------------------------------

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# -------------------------------------------------------------------
# Database configuration: development
# -------------------------------------------------------------------

MYSQL_HOST_DEVELOPMENT=
MYSQL_USER_DEVELOPMENT=
MYSQL_PASSWORD_DEVELOPMENT=
MYSQL_DATABASE_DEVELOPMENT=

# -------------------------------------------------------------------
# Database configuration: test
# -------------------------------------------------------------------

MYSQL_HOST_TEST=
MYSQL_USER_TEST=
MYSQL_PASSWORD_TEST=
MYSQL_DATABASE_TEST=

# -------------------------------------------------------------------
# Database configuration: one staging or production instance per env file
# Set these for the selected instance. Leave them unset to use the legacy
# environment-specific values below during migration.
# -------------------------------------------------------------------

# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# -------------------------------------------------------------------
# Legacy staging database configuration
# TODO: Remove once migration is complete
# -------------------------------------------------------------------

MYSQL_HOST_STAGING=
MYSQL_USER_STAGING=
MYSQL_PASSWORD_STAGING=
MYSQL_DATABASE_STAGING=

# -------------------------------------------------------------------
# Legacy production database configuration
# TODO: Remove once migration is complete
# -------------------------------------------------------------------

MYSQL_HOST_PRODUCTION=
MYSQL_USER_PRODUCTION=
MYSQL_PASSWORD_PRODUCTION=
MYSQL_DATABASE_PRODUCTION=

# -------------------------------------------------------------------
# DataCite configuration: one staging or production instance per env file
# Set these for Kamal. Leave them unset to use the legacy names below.
# -------------------------------------------------------------------

# DATACITE_PREFIX=
# DATACITE_CLIENT_ID=
# DATACITE_PASSWORD=
# DATACITE_URL=

# -------------------------------------------------------------------
# DataCite configuration: development
# -------------------------------------------------------------------

DATACITE_PREFIX_DEVELOPMENT=
DATACITE_CLIENT_ID_DEVELOPMENT=
DATACITE_PASSWORD_DEVELOPMENT=
DATACITE_URL_DEVELOPMENT=

# -------------------------------------------------------------------
# DataCite configuration: test
# -------------------------------------------------------------------

DATACITE_PREFIX_TEST=
DATACITE_CLIENT_ID_TEST=
DATACITE_PASSWORD_TEST=
DATACITE_URL_TEST=

# -------------------------------------------------------------------
# Legacy DataCite configuration: staging
# TODO: Remove once migration is complete
# -------------------------------------------------------------------

DATACITE_PREFIX_STAGING=
DATACITE_CLIENT_ID_STAGING=
DATACITE_PASSWORD_STAGING=
DATACITE_URL_STAGING=

# -------------------------------------------------------------------
# Legacy DataCite configuration: production
# TODO: Remove once migration is complete
# -------------------------------------------------------------------

DATACITE_PREFIX_PRODUCTION=
DATACITE_CLIENT_ID_PRODUCTION=
DATACITE_PASSWORD_PRODUCTION=
DATACITE_URL_PRODUCTION=

# -------------------------------------------------------------------
# Active Storage root for one staging or production instance
# Set STORAGE_FILE_ROOT to the path inside the app container for Kamal.
# Legacy STORAGE_STAGING_ROOT and STORAGE_PROD_ROOT remain below.
# TODO: Remove once migration is complete
# -------------------------------------------------------------------

# STORAGE_FILE_ROOT=
STORAGE_DEV_ROOT=
STORAGE_TEST_ROOT=
STORAGE_STAGING_ROOT=
STORAGE_PROD_ROOT=
