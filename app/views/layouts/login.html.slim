doctype html

html
  head
    meta charset="utf-8"
    meta http-equiv="x-ua-compatible" content="ie=edge"
    meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0"

    = csrf_meta_tags

    == stylesheet_link_tag 'login'
    == javascript_pack_tag 'login'

    title == @project ? @project.name(I18n.locale.to_s) : current_umbrella_project_brand_name

  body
    .layout-indicator style="display: block;"
      .Layout
        .Layout-page.Site

          - if params[:controller] != 'passkeys'
            header.LoginHeader
              - umbrella_logo = InstanceSetting.current.umbrella_project.logo
              = image_tag umbrella_logo ? umbrella_logo.file : "/logo-ohd.svg", class: 'LoginHeader-logo'
              - if @project && @project.logo && !@project.umbrella?
                = image_tag @project.logo.file, class: 'LoginHeader-logo'

          main.Site-content
            .wrapper-content.u-line-length
              .notification-container
                - if notice
                  p.notice = notice
                - if alert
                  p.alert = alert

              = yield
