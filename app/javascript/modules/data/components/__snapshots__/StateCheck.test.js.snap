exports[`renders Spinner component if selector returns false 1`] = `"<span class="Spinner" role="progressbar" aria-label="color-ring-loading" aria-busy="true"><span class="Spinner-ring" aria-hidden="true" style="width:96px;height:96px;border-top-color:var(--primary-color, #e01217)"></span></span>"`;

