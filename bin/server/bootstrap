#!/usr/bin/env bash
# Bootstraps the server(s) of one Kamal destination for rootless Podman.
#
#   bin/server/bootstrap <destination>      e.g. bin/server/bootstrap avd-staging
#
# Runs on your machine. Hosts, ssh user and host directories come from
# config/deploy.yml and the selected instance's environment (see layout.rb). For each
# host it copies remote-bootstrap.sh, podman-autostart.sh and the layout to a temp
# dir on the server and runs remote-bootstrap.sh there. Safe to re-run.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cd "$ROOT"

DEST="${1:-}"
case "$DEST" in
  ""|*[!a-zA-Z0-9_-]*)
    echo "usage: bin/server/bootstrap <destination>" >&2
    exit 2
    ;;
esac
env_file=".env.kamal.$DEST"
if [ ! -f "$env_file" ]; then
  echo "missing $env_file" >&2
  exit 1
fi
set -a
# shellcheck source=/dev/null
source "$env_file"
set +a

LAYOUT="$(ruby "$HERE/layout.rb" "$DEST")"
SSH_USER="$(awk '$1 == "SSH_USER" { print $2 }' <<<"$LAYOUT")"
HOSTS="$(awk '$1 == "HOST" { print $2 }' <<<"$LAYOUT")"
DIRS="$(grep '^DIR ' <<<"$LAYOUT" || true)"

ssh_options=()
if [ -n "${DEPLOY_SSH_KEY:-}" ]; then
  if [ ! -r "$DEPLOY_SSH_KEY" ]; then
    echo "deploy SSH key is not readable: $DEPLOY_SSH_KEY" >&2
    exit 1
  fi
  ssh_options=(-o IdentitiesOnly=yes -i "$DEPLOY_SSH_KEY")
fi

for host in $HOSTS; do
  target="$SSH_USER@$host"
  echo "### $target (destination: $DEST)"
  stage="$(ssh "${ssh_options[@]}" "$target" 'mktemp -d /tmp/ohd-bootstrap.XXXXXX')"
  scp -q "${ssh_options[@]}" "$HERE/remote-bootstrap.sh" "$HERE/podman-autostart.sh" "$target:$stage/"
  printf '%s\n' "$DIRS" | ssh "${ssh_options[@]}" "$target" "cat > '$stage/layout.txt'"
  rc=0
  ssh "${ssh_options[@]}" "$target" "bash '$stage/remote-bootstrap.sh' '$stage'" || rc=$?
  ssh "${ssh_options[@]}" "$target" "rm -rf '$stage'" || true
  if [ "$rc" -ne 0 ]; then
    echo "bootstrap failed on $host (exit $rc)" >&2
    exit "$rc"
  fi
done

echo "### done: $DEST"
