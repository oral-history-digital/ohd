# Defaults loaded by docker-compose.yml for the app and worker containers.
# Kamal reads config/deploy.yml and the selected instance's environment instead.
# Host-specific overrides and secrets belong in the private .env file.
# Suffixed variables below support existing Compose deployments during migration
# to the shared instance variable names documented in .env.example.

# Runtime mode
RAILS_ENV=production
RACK_ENV=production
NODE_ENV=production

# App runtime
PORT=3000
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=false
ALLOW_LOCALHOST_IN_PRODUCTION=false

# Service endpoints
REDIS_URL=redis://redis:6379/0
SOLR_URL=http://solr:8983/solr/default
SOLR_AUTO_COMMIT_AFTER_REQUEST=true
SOLR_AUTO_COMMIT_AFTER_DELETE_REQUEST=true

# Optional integrations, blank by default
SENTRY_DSN=
OIDC_ISSUER=

# Domain values for existing Compose deployments. Empty values are passed to Rails.
OHD_DOMAIN=
OHD_DOMAIN_STAGING=
OHD_DOMAIN_PRODUCTION=

# Active Record encryption keys (required for OTP MFA; secrets belong in .env)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Legacy database names for Compose. Keep until its deployments use MYSQL_*.
MYSQL_HOST_PRODUCTION=db
MYSQL_DATABASE_PRODUCTION=ohd_production
MYSQL_USER_PRODUCTION=ohd
MYSQL_PASSWORD_PRODUCTION=

MYSQL_HOST_STAGING=db
MYSQL_DATABASE_STAGING=ohd_staging
MYSQL_USER_STAGING=ohd
MYSQL_PASSWORD_STAGING=

# Legacy DataCite names for Compose. Keep until its deployments use DATACITE_*.
DATACITE_PREFIX_PRODUCTION=10.17169
DATACITE_CLIENT_ID_PRODUCTION=
DATACITE_PASSWORD_PRODUCTION=
DATACITE_URL_PRODUCTION=https://api.datacite.org/dois

DATACITE_PREFIX_STAGING=10.5072
DATACITE_CLIENT_ID_STAGING=
DATACITE_PASSWORD_STAGING=
DATACITE_URL_STAGING=https://api.test.datacite.org/dois

# Legacy storage roots for Compose. New deployments use STORAGE_FILE_ROOT.
STORAGE_PROD_ROOT=
STORAGE_STAGING_ROOT=
